<div class="min-h-screen bg-slate-50 w-full">
  <!-- Top Navigation (Identical to New/Dashboard for consistency) -->
  <nav class="w-full bg-white border-b border-slate-200 sticky top-0 z-50">
    <div class="w-full px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-4">
        <div class="bg-indigo-600 p-2 rounded-lg text-white">
          <!-- Edit Icon -->
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        </div>
        <h1 class="text-xl font-black text-slate-900 tracking-tight">Modify Transaction</h1>
      </div>
      
      <%= link_to expenses_path, class: "text-sm font-bold text-slate-500 hover:text-indigo-600 flex items-center gap-2 group transition-colors" do %>
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Dashboard
      <% end %>
    </div>
  </nav>

  <div class="w-full flex justify-center py-12 px-6">
    <div class="w-full max-w-2xl">
      <!-- Page Header Section -->
      <div class="mb-10 text-center sm:text-left">
        <span class="inline-block px-3 py-1 rounded-full bg-indigo-50 text-indigo-600 text-[10px] font-black uppercase tracking-widest mb-3">
          Update Entry
        </span>
        <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Edit Expense</h1>
        <p class="text-slate-500 font-medium text-lg">Adjust the details of your previous spend to keep your records accurate.</p>
      </div>

      <!-- Form Card Container -->
      <div class="relative">
        <%# Decorative element behind the card %>
        <div class="absolute -top-6 -right-6 w-32 h-32 bg-indigo-100 rounded-full blur-3xl opacity-50 -z-10"></div>
        <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-slate-200 rounded-full blur-3xl opacity-50 -z-10"></div>

        <%= render "form", expense: @expense %>
      </div>

      <!-- Informational Footer -->
      <div class="mt-12 flex flex-col items-center gap-4 border-t border-slate-200 pt-8">
        <div class="flex items-center gap-2 text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <p class="text-xs font-bold uppercase tracking-widest">End-to-End Encrypted Changes</p>
        </div>
        
        <div class="flex gap-6">
           <p class="text-[10px] font-bold text-slate-400">CREATED: <%= @expense.created_at.strftime("%B %d, %Y") if @expense.created_at %></p>
           <p class="text-[10px] font-bold text-slate-400">LAST UPDATED: <%= @expense.updated_at.strftime("%B %d, %Y") if @expense.updated_at %></p>
        </div>
      </div>
    </div>
  </div>
</div>