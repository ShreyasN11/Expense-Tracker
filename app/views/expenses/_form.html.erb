<div class="bg-white shadow-2xl shadow-slate-200/50 rounded-[2.5rem] border border-slate-100 p-8 md:p-10">
  <%= form_with(model: expense, class: "space-y-8") do |f| %>

    <% if expense.errors.any? %>
      <div class="p-6 bg-rose-50 border border-rose-100 rounded-2xl animate-pulse">
        <div class="flex items-center mb-3">
          <svg class="w-5 h-5 text-rose-600 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1-1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
          <h3 class="text-rose-800 font-black text-sm uppercase tracking-wider">Incomplete Information</h3>
        </div>
        <ul class="list-disc list-inside text-sm text-rose-700 space-y-1 ml-1 font-medium">
          <% expense.errors.full_messages.each do |m| %>
            <li><%= m %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Amount Input -->
    <div class="group">
      <%= f.label :amount, class: "block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
          <span class="text-slate-400 font-black text-xl group-focus-within:text-indigo-600 transition-colors">₹</span>
        </div>
        <%= f.number_field :amount, step: 0.01, placeholder: "0.00",
              class: "w-full pl-12 pr-6 py-5 bg-slate-50 border-2 border-transparent rounded-2xl text-2xl font-black text-slate-900 focus:ring-0 focus:border-indigo-500 focus:bg-white transition-all placeholder:text-slate-200" %>
      </div>
    </div>

    <!-- Description Input -->
    <div>
      <%= f.label :description, class: "block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1" %>
      <%= f.text_field :description, placeholder: "e.g. Monthly Grocery or Office Rent",
            class: "w-full px-6 py-4 bg-slate-50 border-2 border-transparent rounded-2xl font-bold text-slate-900 focus:ring-0 focus:border-indigo-500 focus:bg-white transition-all placeholder:text-slate-300" %>
    </div>

    <!-- Date and Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :spent_on, "Transaction Date", class: "block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1" %>
        <%= f.date_field :spent_on,
              class: "w-full px-6 py-4 bg-slate-50 border-2 border-transparent rounded-2xl font-bold text-slate-900 focus:ring-0 focus:border-indigo-500 focus:bg-white transition-all" %>
      </div>

      <div>
        <%= f.label :category_id, "Classification", class: "block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2 ml-1" %>
        <div class="relative">
          <%= f.collection_select :category_id, Category.all, :id, :name, {}, 
                class: "w-full appearance-none px-6 py-4 bg-slate-50 border-2 border-transparent rounded-2xl font-bold text-slate-900 focus:ring-0 focus:border-indigo-500 focus:bg-white transition-all cursor-pointer" %>
          <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Footer Actions -->
    <div class="pt-6 flex flex-col sm:flex-row items-center gap-4">
      <%= f.submit class: "w-full sm:flex-grow bg-indigo-600 text-white px-8 py-5 rounded-2xl font-black text-lg shadow-xl shadow-indigo-200 hover:bg-indigo-700 hover:-translate-y-1 active:scale-[0.98] transition-all cursor-pointer" %>
      
      <%= link_to "Cancel", expenses_path, 
            class: "w-full sm:w-auto text-center px-8 py-5 rounded-2xl font-bold text-slate-400 hover:text-slate-600 hover:bg-slate-50 transition-all" %>
    </div>

  <% end %>
</div>