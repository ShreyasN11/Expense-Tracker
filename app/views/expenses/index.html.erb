<div class="w-full min-h-screen bg-slate-50 pb-12">
  <!-- Top Navigation - Full Width -->
  <nav class="w-full bg-white border-b border-slate-200 mb-8 sticky top-0 z-50">
    <div class="w-full px-6 sm:px-10 lg:px-12">
      <div class="flex justify-between h-20 items-center">
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">
          Expense<span class="text-indigo-600">Dash</span>
        </h1>
        <div class="flex items-center gap-8">
          <%= link_to new_expense_path, class: "inline-flex items-center px-6 py-3 border border-transparent text-sm font-bold rounded-2xl shadow-lg shadow-indigo-200 text-white bg-indigo-600 hover:bg-indigo-700 transition-all transform hover:-translate-y-0.5" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add Expense
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content Container - Full Width -->
  <div class="w-full px-6 sm:px-10 lg:px-12">
    
    <% if notice.present? %>
      <div class="w-full mb-8 flex items-center p-5 text-emerald-800 bg-emerald-50 border border-emerald-100 rounded-3xl shadow-sm animate-fade-in" role="alert">
        <div class="bg-emerald-500 p-1.5 rounded-full mr-4 text-white">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
        </div>
        <span class="text-sm font-bold"><%= notice %></span>
      </div>
    <% end %>

    <!-- Flex Wrapper forced to full width -->
    <div class="flex flex-col xl:flex-row gap-10 w-full">
      
      <!-- Sidebar / Summary Column -->
      <div class="w-full xl:w-[380px] space-y-6 flex-shrink-0">
        
        <!-- Monthly Total Card -->
        <div class="bg-slate-900 rounded-[2.5rem] shadow-2xl p-10 text-white relative overflow-hidden group">
          <div class="relative z-10">
            <h2 class="text-slate-400 text-xs font-black uppercase tracking-[0.2em] mb-4">Monthly Spending</h2>
            <p class="text-6xl font-black tracking-tighter">₹ <%= number_with_delimiter(@monthly_total) %></p>
            <div class="mt-6 flex items-center text-emerald-400 text-sm font-bold">
              <div class="w-2 h-2 bg-emerald-400 rounded-full animate-ping mr-2"></div>
              <span>Updated Live</span>
            </div>
          </div>
          <div class="absolute -right-10 -top-10 w-48 h-48 bg-indigo-500 rounded-full blur-[80px] opacity-20 group-hover:opacity-40 transition-opacity"></div>
        </div>

        <!-- Monthly Breakdown -->
        <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-200 p-10">
          <h2 class="text-xl font-black text-slate-900 mb-8 flex items-center">
            <span class="w-2.5 h-8 bg-indigo-600 rounded-full mr-4"></span>
            Breakdown
          </h2>
          <div class="space-y-8">
            <% if @monthly_total > 0 %>
              <% @category_totals.each do |name, total| %>
                <% percentage = (total.to_f / @monthly_total * 100).round %>
                <div class="group">
                  <div class="flex justify-between items-end mb-3">
                    <div class="flex flex-col">
                      <span class="text-sm font-black text-slate-600 group-hover:text-indigo-600 transition-colors"><%= name %></span>
                      <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest"><%= percentage %>% contribution</span>
                    </div>
                    <span class="text-sm font-black text-slate-900">₹ <%= number_with_delimiter(total) %></span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                    <div class="bg-indigo-500 h-full rounded-full transition-all duration-1000" 
                         style="width: <%= percentage %>%"></div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-10">
                <p class="text-slate-400 font-bold italic">No records this month</p>
              </div>
            <% end %>
          </div>
        </div>
      </div> <!-- END SIDEBAR -->

      <!-- Main Feed: Spans the remaining full width -->
      <div class="flex-grow w-full">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
          <div>
            <h2 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Recent Expenses</h2>
            <p class="text-slate-500 font-bold text-lg">You have <%= @expenses.count %> transactions recorded</p>
          </div>
          <div class="bg-white border-2 border-slate-100 rounded-2xl px-6 py-3 text-sm font-black text-slate-500 shadow-sm">
             CURRENT BILLING PERIOD
          </div>
        </div>

        <!-- Ultra Responsive Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 2xl:grid-cols-3 3xl:grid-cols-4 4xl:grid-cols-5 gap-8">
          <% @expenses.each do |expense| %>
            <div class="bg-white border border-slate-200 rounded-[2rem] p-8 hover:shadow-2xl hover:shadow-indigo-100/50 hover:border-indigo-100 transition-all duration-300 flex flex-col group relative">
              <div class="flex justify-between items-start mb-6">
                <div class="h-14 w-14 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-400 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300 shadow-inner">
                  <span class="font-black text-xl">₹</span>
                </div>
                <span class="inline-flex items-center px-4 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-[0.15em] bg-indigo-50 text-indigo-600">
                  <%= expense.category.name %>
                </span>
              </div>
              
              <div class="flex-grow">
                <p class="text-3xl font-black text-slate-900 mb-2">₹ <%= number_with_delimiter(expense.amount) %></p>
                <p class="text-slate-500 font-bold leading-relaxed"><%= expense.description %></p>
              </div>
              
              <div class="mt-8 pt-6 border-t border-slate-50 flex items-center justify-between">
                <div class="flex items-center text-xs font-black text-slate-400 uppercase tracking-widest">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  <%= expense.spent_on.strftime("%b %d, %Y") if expense.spent_on %>
                </div>

                <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-all transform translate-y-2 group-hover:translate-y-0">
                  <%= link_to edit_expense_path(expense), class: "p-2.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition-colors" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                  <% end %>
                  <%= button_to expense, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "p-2.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-colors" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <% if @expenses.empty? %>
          <div class="mt-10 text-center py-32 bg-white rounded-[3rem] border-4 border-dashed border-slate-100">
            <h3 class="text-2xl font-black text-slate-300">Nothing to show yet</h3>
            <%= link_to "Add your first expense", new_expense_path, class: "text-indigo-600 font-black hover:underline mt-4 inline-block text-lg" %>
          </div>
        <% end %>
      </div> <!-- END MAIN FEED -->

    </div>
  </div>
</div>